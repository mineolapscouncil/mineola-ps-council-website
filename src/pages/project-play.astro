---
import Layout from '../layouts/BaseLayout.astro';
import PlayArt from '../components/PlayArt.astro';
import Progress from '../components/FundraisingProgress.astro';
import Card from '../components/Card.astro';
import campaign from '../data/project-play.json';
import site from '../data/site.json';
import {entries,safeUrl,date} from '../lib/content';
const milestones=entries('milestones'); const actions=entries('fundraising-actions','active'); const faqs=entries('faqs'); const updates=entries('updates','published').sort((a,b)=>(b.date||'').localeCompare(a.date||''));
const donation=safeUrl(campaign.ctaUrl);
---
<Layout title={campaign.seoTitle} description={campaign.seoDescription}><section class="hero wrap"><div><a class="breadcrumb" href="/">Home /</a><p class="eyebrow">{campaign.title} · {campaign.status}</p><h1>{campaign.description}</h1><p class="intro">{campaign.tagline}</p><a class="button" href="#support">{campaign.ctaLabel} ↗</a></div><div class="hero-art">{campaign.heroImage?<img src={safeUrl(campaign.heroImage)} alt={campaign.heroAlt} width="700" height="490"/>:<PlayArt/>}<p class="caption">{campaign.heroImage?'Project Play':'Concept illustration only. This is not a proposed playground design.'}</p></div></section><section class="wrap story"><div><p class="eyebrow">Room to imagine. Space to grow.</p><h2>Let’s make room<br/>for more play.</h2><p>{campaign.story}</p>{date(campaign.deadline)&&<p>Fundraising deadline: {date(campaign.deadline)}</p>}</div><Progress/></section><section class="wrap"><p class="eyebrow">One step at a time</p><h2>The path to a new playground.</h2>{milestones.length?<ol class="timeline">{milestones.map(m=><li><span class="eyebrow">{m.status}{date(m.date)&&' · '+date(m.date)}</span><h3>{m.title}</h3><p>{m.description}</p></li>)}</ol>:<p class="notice">Confirmed project milestones and dates will be posted here as planning progresses.</p>}</section><section class="wrap" id="support"><p class="eyebrow">Be part of the story</p><h2>A little support goes a long way.</h2>{donation&&<p><a class="button" href={donation} target="_blank" rel="noopener noreferrer">{campaign.ctaLabel} ↗</a><small class="destination">Continue to {new URL(donation,'https://mineolapscouncil.ca').hostname}</small></p>}<div class="grid">{actions.length?actions.map((item,index)=><Card {item} {index}/>):<div class="card empty"><h3>Ways to support are coming soon.</h3><p>Council-approved donation links and fundraising opportunities will be added here once confirmed.</p><a class="text-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Follow campaign news on Instagram ↗</a></div>}</div></section>{updates.length>0&&<section class="wrap"><h2>Project updates</h2><div class="grid">{updates.map((item,index)=><div><p>{date(item.date)}</p><Card {item} {index}/></div>)}</div></section>}{faqs.length>0&&<section class="wrap"><h2>Your questions, answered.</h2>{faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</section>}<section class="involved wrap"><div><p class="eyebrow">Built by a community</p><h2>Big things start<br/>with all of us.</h2></div><div><p>Share Project Play with your family and neighbours. Follow council for confirmed campaign news and opportunities to take part.</p><a class="button" href={donation||site.instagramUrl} target="_blank" rel="noopener noreferrer">{donation?campaign.ctaLabel:'Follow Project Play updates'} ↗</a></div></section></Layout>