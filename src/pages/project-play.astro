---
import Layout from '../layouts/BaseLayout.astro';
import Progress from '../components/FundraisingProgress.astro';
import campaign from '../data/project-play.json';
import site from '../data/site.json';
import {entries,safeUrl,date} from '../lib/content';
const events=entries('events').sort((a,b)=>(a.start||'9999').localeCompare(b.start||'9999')||(a.order??0)-(b.order??0));
const donation=safeUrl(campaign.ctaUrl);
const status=(event:Record<string,any>)=>event.status||'Upcoming';
---
<Layout title={campaign.seoTitle} description={campaign.seoDescription}><div class="campaign"><section class="campaign-intro"><a class="back" href="/">← Back to council</a><p class="eyebrow">A new playground for Mineola</p><h1>{campaign.title}</h1><p class="intro">{campaign.story}</p>{donation&&<a class="button" href={donation} target={donation.startsWith('http')?'_blank':undefined} rel={donation.startsWith('http')?'noopener noreferrer':undefined}>{campaign.ctaLabel} ↗</a>}</section><Progress/><section class="events" aria-labelledby="events-title"><h2 id="events-title">What’s happening</h2>{events.length?<ol class="event-timeline">{events.map(event=><li><div class="event-heading"><span class:list={['status',{'running':status(event)==='Running','completed':status(event)==='Completed'}]}>{status(event)}</span><span class="event-date">{date(event.start)||'Date to come'}{date(event.end)&&date(event.end)!==date(event.start)&&` – ${date(event.end)}`}</span></div><h3>{event.title}</h3>{event.description&&<p>{event.description}</p>}{event.location&&<p class="location">{event.location}</p>}{safeUrl(event.url)&&<a class="text-link" href={safeUrl(event.url)} target={event.url.startsWith('http')?'_blank':undefined} rel={event.url.startsWith('http')?'noopener noreferrer':undefined}>{event.ctaLabel||'Event details'} ↗</a>}</li>)}</ol>:<p class="empty-state">Our next fundraising events will be posted here soon.</p>}</section><a class="instagram-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Follow along on Instagram ↗</a></div></Layout>
