---
import { renderDescription } from '../lib/rich-text.mjs';
import DonationInstructions from '../components/DonationInstructions.astro';
import Layout from '../layouts/BaseLayout.astro';
import Progress from '../components/FundraisingProgress.astro';
import campaign from '../data/project-play.json';
import InstagramIcon from '../components/InstagramIcon.astro';
import site from '../data/site.json';
import {entries,safeUrl,date} from '../lib/content';
const events=entries('events').sort((a,b)=>(a.start||'9999').localeCompare(b.start||'9999')||(a.order??0)-(b.order??0));
const donation=safeUrl(campaign.ctaUrl);
const money=(n:number)=>new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD',maximumFractionDigits:2}).format(n);
const status=(event:Record<string,any>)=>event.status||'Upcoming';
---
<Layout title={campaign.seoTitle} description={campaign.seoDescription}><div class="campaign"><section class="campaign-intro"><p class="eyebrow">A new playground for Mineola</p><h1>{campaign.title}</h1><p class="intro">{campaign.story}</p>{donation&&<DonationInstructions url={donation} label={campaign.ctaLabel}/>}</section><Progress/><section class="events" aria-labelledby="events-title"><h2 id="events-title">Our fundraisers</h2>{events.length?<ol class="event-timeline">{events.map(event=><li><div class="event-heading"><span class:list={['status',{'running':status(event)==='Running','completed':['Completed','Closed'].includes(status(event))}]}>{status(event)}</span><span class="event-date">{event.dateLabel||date(event.start)||'Date to come'}{date(event.end)&&date(event.end)!==date(event.start)&&` – ${date(event.end)}`}</span></div><h3>{event.title}</h3>{event.description&&<div class="event-description" set:html={renderDescription(event.description)} />}{event.location&&<p class="location">{event.location}</p>}{status(event)!=='Closed'&&safeUrl(event.url)&&<a class="button event-cta" href={safeUrl(event.url)} target={event.url.startsWith('http')?'_blank':undefined} rel={event.url.startsWith('http')?'noopener noreferrer':undefined}>{event.ctaLabel||'Event details'}</a>}</li>)}</ol>:<p class="empty-state">Our next fundraising events will be posted here soon.</p>}</section><a class="instagram-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer"><InstagramIcon/><span>Follow us on Instagram</span></a></div></Layout>
