---
import Layout from '../layouts/BaseLayout.astro';
import PlayArt from '../components/PlayArt.astro';
import Progress from '../components/FundraisingProgress.astro';
import Card from '../components/Card.astro';
import site from '../data/site.json';
import campaign from '../data/project-play.json';
import {entries,safeUrl,date} from '../lib/content';
const initiatives=entries('initiatives').sort((a,b)=>Number(b.featured)-Number(a.featured)||(a.order??0)-(b.order??0));
const announcements=entries('announcements','published').sort((a,b)=>(b.date||'').localeCompare(a.date||''));
const events=entries('events').sort((a,b)=>(a.start||'').localeCompare(b.start||''));
---
<Layout><section class="hero wrap"><div><p class="eyebrow">Mineola Public School Council</p><h1>{site.headline}</h1><p class="intro">{site.introduction}</p><div class="buttons"><a class="button" href="/project-play/">Explore Project Play ↗</a><a class="text-link" href={site.schoolUrl} target="_blank" rel="noopener noreferrer">Our school ↗</a></div></div><div class="hero-art">{site.heroImage?<img src={safeUrl(site.heroImage)} alt={site.heroAlt} width="700" height="490"/>:<PlayArt/>}<span class="sticker">Big dreams.<br/>Little adventurers.</span><p class="caption">{site.heroImage?'Our school community':'A little imagination for what comes next. Illustration only.'}</p></div></section><div class="ribbon" aria-hidden="true">LEARN TOGETHER <span>✳</span> GROW TOGETHER <span>✳</span> PLAY TOGETHER <span>✳</span> BELONG TOGETHER</div><section class="wrap feature"><div class="feature-art"><PlayArt/><span class="pill">OUR BIG COMMUNITY PROJECT</span></div><div class="feature-copy"><p class="eyebrow">Introducing Project Play</p><h2>A new chapter.<br/>A new place to play.</h2><p>{campaign.story}</p><a class="button" href="/project-play/">Help build our new playground ↗</a></div><div class="feature-progress"><Progress/></div></section><section class="wrap" id="initiatives"><div class="section-heading"><div><p class="eyebrow">There’s a place for everyone</p><h2>Little actions. Lasting impact.</h2></div><p>Discover what’s happening in our school community.</p></div><div class="grid">{initiatives.length?initiatives.map((item,index)=><Card {item} {index}/>):<article class="card empty"><span class="eyebrow">Watch this space</span><h3>More ways to connect are on their way.</h3><p>Confirmed school council initiatives will appear here. For now, explore Project Play and follow council on Instagram.</p><a class="text-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">Follow council ↗</a></article>}</div></section>{events.length>0&&<section class="wrap"><h2>On the calendar</h2><div class="grid">{events.map((item,index)=><div><p>{date(item.start)}</p><Card {item} {index}/></div>)}</div></section>}{announcements.length>0&&<section class="wrap"><h2>Community announcements</h2><div class="grid">{announcements.map((item,index)=><div><p>{date(item.date)}</p><Card {item} {index}/></div>)}</div></section>}<section class="wrap about"><p class="eyebrow">Rooted in community</p><h2>Our school. Our families.<br/>Our shared future.</h2><p>Mineola Public School Council brings parents and caregivers together to support student experiences and build connections. For school programs, administration and official notices, visit the school website.</p><a class="text-link" href={site.schoolUrl} target="_blank" rel="noopener noreferrer">Get to know Mineola Public School ↗</a></section><section class="involved wrap" id="get-involved"><div><p class="eyebrow">You belong here</p><h2>Many hands.<br/>So many possibilities.</h2></div><div><p>Have an idea? A little time to give? A passion for making things happen? There are many ways to be part of our school community.</p><a class="button" href={safeUrl(site.volunteerUrl)||site.instagramUrl} target="_blank" rel="noopener noreferrer">{site.volunteerUrl?'Get involved':'Connect on Instagram'} ↗</a></div></section></Layout>