---
import Layout from '../layouts/BaseLayout.astro';
import HomePageCard from '../components/HomePageCard.astro';
import {entries,safeUrl} from '../lib/content';
import InstagramIcon from '../components/InstagramIcon.astro';
import site from '../data/site.json';
const cards=entries('home-page-cards').filter(card=>safeUrl(card.url));
const primaryCards=cards.filter(card=>card.style!=='Secondary');
const secondaryCards=cards.filter(card=>card.style==='Secondary');
---
<Layout><section class="landing"><img class="landing-logo" src="/images/mineola-council-logo.png" alt="Mineola Public School Council" width="1298" height="1212" fetchpriority="high" /><h1>{site.headline}</h1><p class="intro">{site.introduction}</p>{primaryCards.length>0&&<div class="home-cards primary-cards">{primaryCards.map(card=><HomePageCard {card}/>)}</div>}{secondaryCards.length>0&&<section class="secondary-section" aria-labelledby="other-things-title"><h2 id="other-things-title" class="secondary-heading">{site.secondaryCardsHeading||'Other things at Mineola'}</h2><div class="home-cards secondary-cards">{secondaryCards.map(card=><HomePageCard {card}/>)}</div></section>}<a class="instagram-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer"><InstagramIcon/><span>Follow us on Instagram</span></a></section></Layout>
