---
import Layout from '../layouts/BaseLayout.astro';
import PlaygroundIcon from '../components/PlaygroundIcon.astro';
import InstagramIcon from '../components/InstagramIcon.astro';
import site from '../data/site.json';
---
<Layout><section class="landing"><img class="landing-logo" src="/images/mineola-council-logo.png" alt="Mineola Public School Council" width="1298" height="1212" fetchpriority="high" /><h1>{site.headline}</h1><p class="intro">{site.introduction}</p><a class="project-link" href="/project-play/"><span class="project-symbol" aria-hidden="true"><PlaygroundIcon/></span><span><span class="eyebrow">Our playground fundraiser</span><h2>Project Play</h2><span>Help us build a new place to play.</span></span><span class="arrow" aria-hidden="true">→</span></a><a class="instagram-link" href={site.instagramUrl} target="_blank" rel="noopener noreferrer"><InstagramIcon/><span>Follow us on Instagram</span></a></section></Layout>
