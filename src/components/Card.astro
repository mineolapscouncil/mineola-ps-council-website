---
import {safeUrl} from '../lib/content';
const {item,index=0}=Astro.props;
const url=safeUrl(item.url); const external=url.startsWith('http');
---
<article class:list={['card','tone-'+index%3]}>{item.image&&<img src={safeUrl(item.image)} alt={item.imageAlt||''} loading="lazy" width="640" height="420"/>}<span class="eyebrow">{item.category||'Our community'}</span><h3>{item.title}</h3><p>{item.description}</p>{item.location&&<p>{item.location}</p>}{url&&<a class="text-link" href={url} target={external?'_blank':undefined} rel={external?'noopener noreferrer':undefined}>{item.ctaLabel||'Find out more'} {external?'↗':'→'}</a>}</article>