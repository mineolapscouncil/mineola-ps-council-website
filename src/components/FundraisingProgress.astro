---
import campaign from '../data/project-play.json';
import {date} from '../lib/content';
const {goal,raised}=campaign;
const confirmed=campaign.showProgress && typeof goal==='number' && Number.isFinite(goal) && goal>0 && typeof raised==='number' && Number.isFinite(raised) && raised>=0;
const percent=confirmed?Math.min(100,Math.max(0,Number(raised)/Number(goal)*100)):0;
const money=(n:number)=>new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD',maximumFractionDigits:0}).format(n);
---
<section class="fundraiser" aria-labelledby="fundraising-title"><div class="thermometer-layout"><div class:list={['thermometer',{'unconfirmed':!confirmed}]} aria-hidden="true"><div class="tube"><div class="mercury" style={`height:${percent}%`}></div></div><div class="bulb"></div><div class="ticks">{[100,75,50,25,0].map(t=><span>{confirmed?money(Number(goal)*t/100):'—'}</span>)}</div></div><div class="fundraising-copy"><h2 id="fundraising-title">{confirmed?'Look what we’re building together.':'Every bit brings us closer.'}</h2>{confirmed?<><p class="raised">{money(Number(raised))}</p><p class="goal">raised toward our {money(Number(goal))} goal <span>(CAD)</span></p><progress class="sr-only" max="100" value={percent} aria-label="Fundraising goal reached">{percent.toFixed(1)}%</progress><p class="progress-note">{percent.toFixed(1)}% of our goal{Number(raised)<Number(goal)&&` · ${money(Number(goal)-Number(raised))} to go`}</p>{date(campaign.lastUpdated)&&<small>Updated {date(campaign.lastUpdated)}</small>}</>:<p>We’ll share our fundraising goal and total here soon.</p>}</div></div></section>
