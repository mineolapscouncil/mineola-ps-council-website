---
import campaign from '../data/project-play.json';
import {date} from '../lib/content';
const {goal,raised}=campaign;
const valid=campaign.showProgress && typeof goal==='number' && Number.isFinite(goal) && goal>0 && typeof raised==='number' && Number.isFinite(raised) && raised>=0;
const percent=valid?Math.min(100,Math.max(0,Number(raised)/Number(goal)*100)):0;
const money=(n:number)=>new Intl.NumberFormat('en-CA',{style:'currency',currency:'CAD',maximumFractionDigits:0}).format(n);
---
<div class="progress-panel">{valid ? <><p class="eyebrow">Growing together</p><p class="amount">{money(Number(raised))} <small>raised of {money(Number(goal))} CAD</small></p><progress max="100" value={percent} aria-label="Fundraising goal reached">{percent.toFixed(1)}%</progress><p>{percent.toFixed(1)}% of goal · {money(Math.max(0,Number(goal)-Number(raised)))} remaining</p>{date(campaign.lastUpdated)&&<small>Updated {date(campaign.lastUpdated)}</small>}</> : <><p class="eyebrow">Every great playground starts with community</p><h3>Something wonderful is taking shape.</h3><p>Confirmed fundraising totals and our goal will be shared here as campaign details become available.</p></>}</div>